<Project>
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>15.0</LangVersion>
    <AnalysisLevel>11.0</AnalysisLevel>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <VeloSimRuntimeAsync Condition="'$(VeloSimRuntimeAsync)' == ''">true</VeloSimRuntimeAsync>
    <Features Condition="'$(TargetFramework)' == 'net11.0' and '$(VeloSimRuntimeAsync)' == 'true'">$(Features);runtime-async=on</Features>
  </PropertyGroup>
</Project>
