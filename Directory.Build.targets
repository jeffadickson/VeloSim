<Project>
  <PropertyGroup><VeloSimNativeJobs Condition="'$(VeloSimNativeJobs)' == ''">4</VeloSimNativeJobs></PropertyGroup>
  <Target Name="VeloSimBoundNativeCompilerParallelism" BeforeTargets="WriteIlcRspFileForCompilation" Condition="'$(PublishAot)' == 'true'">
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(VeloSimNativeJobs)', '^([1-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-6])$'))" Text="VeloSimNativeJobs must be in 1..256." />
    <ItemGroup Condition="'$(IlcSingleThreaded)' != 'true'"><IlcArg Include="--parallelism:$(VeloSimNativeJobs)" /></ItemGroup>
  </Target>
</Project>
