@using Microsoft.JSInterop
@inject IJSRuntime Browser
@inject RcBrowserSolver RcSolver

<main @onkeydown="CancelOnEscape">
    <header><p class="eyebrow">CIRCUIT NOTEBOOK / 01</p><h1>@(IsRc ? "Charging a capacitor" : "The voltage divider")</h1>
        <p>@(IsRc ? "Change the resistance or capacitance and watch the probe trace." : "Build a circuit, change a resistor, and see where the voltage goes.")</p></header>
    <section class="layout">
        <div class="sheet">
            <nav aria-label="Schematic tools">
                @foreach (var kind in QuickParts)
                {
                    <button aria-pressed="@(placing == kind ? "true" : "false")" @onclick="() => Choose(kind)">+ @kind</button>
                }
                <button @onclick="Reset">Reset example</button>
                <button @onclick="SaveSheet">Save sheet</button>
                <button @onclick="ReloadSheet">Reload sheet</button>
                <button disabled="@(!session.CanUndo)" @onclick="() => RestoreEdit(new UndoEdit(session.Version))">Undo</button>
                <button @onclick="() => Dispatch(new CheckCircuit())">Check circuit</button>
                <button disabled="@(!session.CanRedo)" @onclick="() => RestoreEdit(new RedoEdit(session.Version))">Redo</button>
                <button @onclick="() => Dispatch(new LoadRc(session.Version))">Open RC example</button>
                <button @onclick="OpenBridgeDemo">Open mixed RLC example</button>
                <button @onclick="() => Dispatch(new LoadModelDemo(session.Version))">Open semiconductor example</button>
                <button @onclick="() => Dispatch(new LoadBjtDemo(session.Version))">Open BJT example</button>
                <button @onclick="() => Dispatch(new LoadBsim3Demo(session.Version))">Open BSIM3 example</button>
                <div class="catalog">
                    <button type="button" aria-expanded="@(session.CatalogOpen ? "true" : "false")" @onclick="() => Dispatch(new ToggleCatalog())">Parts library</button>
                    @if (session.CatalogOpen)
                    {
                    <label for="part-search">Find a generic symbol</label>
                    <input id="part-search" value="@session.Filter" @oninput="e => Dispatch(new SetCatalogFilter(Input(e)), announce: false)" placeholder="e.g. MOSFET or capacitor" />
                    @foreach (var group in VisibleParts())
                    {
                        <p class="eyebrow">@group.Key</p>
                        @foreach (var kind in group)
                        {
                            <button @onclick="() => Choose(kind)">@PartCatalog.Get(kind).Name</button>
                        }
                    }
                    }
                </div>
            </nav>
            @{ var highlighted = session.HighlightedNet; }
            <svg viewBox="0 0 640 370" role="group" aria-label="Interactive circuit schematic">
                <defs><pattern id="grid" width="20" height="20" patternUnits="userSpaceOnUse">
                    <circle cx="0" cy="0" r="1" fill="#cad3cb" />
                </pattern></defs>
                <rect width="640" height="370" fill="url(#grid)" />
                @foreach (var wire in session.Wires)
                {
                    var a = PinPosition(wire.A);
                    var b = PinPosition(wire.B);
                    // Route two top pins above their bodies, and approach the ground from above.
                    var target = session.Parts.First(p => p.Id == wire.B.Part);
                    var bend = target.Kind switch
                    {
                        Kind.Probe => b.Y,
                        Kind.Ground => b.Y - 18,
                        _ when wire.A.Index == 0 && wire.B.Index == 0 => Math.Min(a.Y, b.Y) - 20,
                        _ => (a.Y + b.Y) / 2
                    };
                    @if (session.Routes.FirstOrDefault(route => route.Wire == wire) is { } route)
                    {
                        <polyline class="wire @(highlighted?.Wires.Contains(wire) == true ? "net-highlight" : "")" points="@WirePoints(a, b, route.Bends)" />
                    }
                    else
                    {
                        <path class="wire @(highlighted?.Wires.Contains(wire) == true ? "net-highlight" : "")" d="M @a.X @a.Y V @bend H @b.X V @b.Y" />
                    }
                }
                @foreach (var junction in session.Junctions)
                {
                    <circle class="@(highlighted?.Junctions.Contains(junction.Id) == true ? "net-highlight" : "")" cx="@junction.At.X" cy="@junction.At.Y" r="5" fill="#216851" />
                }
                @foreach (var part in session.Parts)
                {
                    <g transform="translate(@part.X @part.Y)" class="@(selected == part.Id ? "part selected" : "part")">
                        <rect class="hit" x="-25" y="-24" width="50" height="48" rx="6" tabindex="0" role="button"
                              aria-label="Select @part.Id" @onclick="() => Select(part.Id)" @onkeydown="e => Key(e, () => Select(part.Id))" />
                        <path class="art" transform="@Orientation(part)" d="@PartCatalog.Get(part.Kind).Artwork" />
                        @if (PartCatalog.Get(part.Kind).Mark is { } mark)
                        {
                            <foreignObject x="-20" y="-8" width="40" height="17">
                                <span class="symbol-mark">@mark</span>
                            </foreignObject>
                        }
                        <foreignObject x="40" y="-20" width="90" height="40">
                            <span class="label @(part.Kind == Kind.Probe ? "probe-label" : "")">@part.Id @ValueLabel(part)</span>
                        </foreignObject>
                        @for (var i = 0; i < part.PinCount; i++)
                        {
                            var pin = new Pin(part.Id, i);
                            var anchor = part.PinPosition(i);
                            <circle class="@(pending == pin || session.FocusedTerminal == pin ? "pin pending" : "pin") @(highlighted?.Terminals.Contains(pin) == true ? "net-highlight" : "")" cx="@(anchor.X - part.X)" cy="@(anchor.Y - part.Y)" r="7"
                                    tabindex="0" role="button" aria-label="@PinLabel(part, i)"
                                    @onclick="() => TapPin(pin)" @onkeydown="e => Key(e, () => TapPin(pin))" />
                        }
                    </g>
                }
                @foreach (var label in session.Labels)
                {
                    var anchor = PinPosition(label.Terminal);
                    <foreignObject x="@(anchor.X + 8)" y="@(Math.Max(0, anchor.Y - 38))" width="110" height="24">
                        <span class="label net-name @(highlighted?.Terminals.Contains(label.Terminal) == true ? "net-highlight" : "")">@label.Name</span>
                    </foreignObject>
                }
                @if (session.MoveGesture is { } move)
                {
                    @foreach (var slot in Slots)
                    {
                        if (session.Parts.Any(p => (move.Duplicate || p.Id != move.PartId) &&
                            Math.Abs(p.X - slot.X) < 64 && Math.Abs(p.Y - slot.Y) < 55)) continue;
                        <circle class="slot" cx="@slot.X" cy="@slot.Y" r="10" tabindex="0" role="button"
                                aria-label="Destination @slot.X, @slot.Y" @onclick="() => MoveTo(move, slot)"
                                @onkeydown="e => Key(e, () => MoveTo(move, slot))" />
                    }
                }
                @if (placing is Kind kindToPlace)
                {
                    @foreach (var slot in Slots)
                    {
                        if (session.Parts.Any(p => Math.Abs(p.X - slot.X) < 64 && Math.Abs(p.Y - slot.Y) < 55)) continue;
                        <circle class="slot" cx="@slot.X" cy="@slot.Y" r="10" tabindex="0" role="button"
                                aria-label="Place @kindToPlace at @slot.X, @slot.Y" @onclick="() => Place(kindToPlace, slot)"
                                @onkeydown="e => Key(e, () => Place(kindToPlace, slot))" />
                    }
                }
            </svg>
            <p class="status" role="status">@status</p>
            <section class="status wiring" aria-label="Wiring tools">
                <label for="net-terminal">Net terminal</label>
                <select id="net-terminal" value="@TerminalKey(session.Wiring.Terminal)" @onchange="ChooseTerminal">
                    <option value="">Select terminal</option>
                    @foreach (var part in session.Parts)
                    {
                        @for (var index = 0; index < part.PinCount; index++)
                        {
                            var pin = new Pin(part.Id, index);
                            <option value="@TerminalKey(pin)">@part.Id pin @(index + 1)</option>
                        }
                    }
                </select>
                <label for="net-name">Net name</label>
                <input id="net-name" maxlength="48" value="@session.Wiring.Name" @oninput="e => Draft(session.Wiring with { Name = Input(e) })" />
                <div class="wiring-actions"><button disabled="@(session.Wiring.Terminal is null)" @onclick="ApplyLabel">Apply net label</button>
                    <button disabled="@(session.Wiring.Terminal is null)" @onclick="() => Dispatch(new HighlightNet(session.Wiring.Terminal))">Highlight net</button>
                    <button disabled="@(highlighted is null)" @onclick="() => Dispatch(new HighlightNet(null))">Clear net highlight</button>
                </div>
                <label for="wire-one">Wire</label>
                <select id="wire-one" value="@WireKey(session.Wiring.First)" @onchange="e => ChooseWire(e, false)">
                    <option value="">Select wire</option>
                    @foreach (var wire in session.Wires)
                    {
                        <option value="@WireKey(wire)">@WireName(wire)</option>
                    }
                </select>
                <label for="wire-points">Bends or junction point (x,y)</label>
                <input id="wire-points" maxlength="256" placeholder="250,145 280,160" value="@session.Wiring.Bends"
                       @oninput="e => Draft(session.Wiring with { Bends = Input(e) })" />
                <div class="wiring-actions"><button disabled="@(session.Wiring.First is null)" @onclick="ApplyRoute">Apply route</button>
                <button disabled="@(session.Wiring.First is null)" @onclick="RemoveWire">Delete wire</button></div>
                <label for="wire-two">Second wire for junction</label>
                <select id="wire-two" value="@WireKey(session.Wiring.Second)" @onchange="e => ChooseWire(e, true)">
                    <option value="">Select second wire</option>
                    @foreach (var wire in session.Wires)
                    {
                        <option value="@WireKey(wire)">@WireName(wire)</option>
                    }
                </select>
                <div class="wiring-actions">                <button disabled="@(session.Wiring.First is null || session.Wiring.Second is null)" @onclick="JoinAtPoint">Join wires at point</button></div>
                @foreach (var junction in session.Junctions)
                {
                    <button @onclick="() => Dispatch(new DeleteJunction(session.Version, junction.Id))">
                        Delete junction @junction.At.X,@junction.At.Y
                    </button>
                }
            </section>
            @if (preflight is { Findings: { } findings } checkedCircuit && checkedCircuit.Version == session.Version)
            {
                <section class="status" aria-label="Circuit findings">
                    @if (findings.Count == 0)
                    {
                        <p>No circuit findings.</p>
                    }
                    @foreach (var finding in findings)
                    {
                        <p><strong>@(finding.Blocking ? "Error" : "Warning")</strong> @finding.Message
                            @if (finding.Terminal is Pin terminal)
                            {
                                <button @onclick="() => Dispatch(new FocusTerminal(terminal))">Highlight @terminal.Part pin @(terminal.Index + 1)</button>
                            }
                        </p>
                    }
                </section>
            }
        </div>
        <aside>
            <p class="eyebrow">VOLTAGE PROBE · @(session.Parts.FirstOrDefault(p => p.Kind == Kind.Probe)?.Id ?? "none")</p>
            <output aria-live="polite" data-testid="voltage">@(ProbeVoltage is double voltage ? $"{voltage:0.###} V" : "—")</output>
            @if (IsRc)
            {
                <p>Select the probe and run the transient to see the capacitor charge. The readout shows the final sample.</p>
            }
            else
            {
            <p>With no load, the lower resistor sets the share of supply voltage at the midpoint.</p>
            <p class="formula">Vout = Vin × Rlower / (Rupper + Rlower)</p>
            }
            @if (session.Parts.FirstOrDefault(p => p.Id == selected) is Part active)
            {
                <div class="inspector"><strong>@active.Id · @PartCatalog.Get(active.Kind).Name</strong>
                    <small>@(PartReadiness(active.Kind))</small>
                    @if (PartCatalog.ValueUnit(active.Kind) is { } unit)
                    {
                        <label for="value">Value (@unit)</label>
                        <input id="value" type="number" step="any" value="@session.DraftValue" @oninput="e => Dispatch(new SetDraftValue(Input(e)), announce: false)" />
                        <button @onclick="Apply">Apply value</button>
                    }
                    @if (active.Kind == Kind.Probe && session.Parts.Any(p => p.Kind == Kind.PulseVoltage))
                    {
                        <button disabled="@transientRunning" @onclick="() => RunRc(active.Id)">Run RC transient</button>
                    }
                    <button @onclick="() => Dispatch(new ArmMove(active.Id))">Move part</button>
                    <button @onclick="() => Dispatch(new RotatePart(session.Version, active.Id))">Rotate clockwise</button>
                    <button @onclick="() => Dispatch(new MirrorPart(session.Version, active.Id))">Mirror part</button>
                    <button @onclick="() => Dispatch(new ArmMove(active.Id, Duplicate: true))">Duplicate part</button>
                    <button class="remove" @onclick="Remove">Delete @active.Id</button>
                </div>
            }
        </aside>
    </section>
    @{
        var history = session.History;
        var choices = IsRc
            ? history.Transients.Select((run, index) => (run.Id, Label: $"RC transient {index + 1}")).ToArray()
            : history.Sweeps.Select((run, index) => (run.Id, Label: $"DC sweep {index + 1}")).ToArray();
        var displayed = IsRc ? transientResult?.Transient?.Id : sweepResult?.Run?.Id;
    }
    @if (choices.Length > 0)
    {
        <div class="history-picker">
            <label for="analysis-history">Analysis history</label>
            <select id="analysis-history" value="@(displayed?.ToString() ?? "")" @onchange="ChooseRun">
                <option value="" disabled>Select a run</option>
                @foreach (var choice in choices)
                {
                    <option value="@choice.Id">@choice.Label</option>
                }
            </select>
        </div>
    }
    @if (!IsRc)
    {
    <section class="results" aria-label="Simulation results">
        <div><p class="eyebrow">SIMULATION RESULTS</p><h2>DC input sweep</h2>
            <p>Analytical divider model. The trace shows the voltage at the probe as the supply rises.</p>
            <button @onclick="Run">Run DC sweep</button>
        </div>
        @if (sweepResult is { } result)
        {
            if (result.Run is not { } latestRun)
            {
                <p role="status">@(result.Version == session.Version ? result.Message : "The circuit changed. Run the sweep again.")</p>
            }
            else
            {
                var sweep = latestRun.Samples;
                var limit = sweep[^1].Input;
                @if (!session.IsCurrent(latestRun.Id, latestRun.Version))
                {
                    <p role="status">The circuit changed. Run the sweep again to update this trace.</p>
                }
                <figure>
                    <svg viewBox="0 0 520 220" role="img" aria-label="DC sweep plot of probe voltage against input voltage">
                        <path d="M60 25V174H493" class="axis" />
                        <path d="M60 99H493M276 25V174" class="guide" />
                        <polyline class="trace" points="@Plot(sweep, limit)" />
                        <circle class="trace-end" cx="493" cy="@Coordinate(174 - 149 * (sweep[^1].Probe / limit))" r="4" />
                        <foreignObject x="6" y="15" width="53" height="30"><span>@($"{limit:G4} V")</span></foreignObject>
                        <foreignObject x="12" y="153" width="46" height="20"><span>0 V</span></foreignObject>
                        <foreignObject x="427" y="182" width="83" height="24"><span>@($"{limit:G4} V")</span></foreignObject>
                        <foreignObject x="205" y="185" width="170" height="25"><span>Input voltage (V)</span></foreignObject>
                    </svg>
                    <figcaption><span class="legend"></span> Probe voltage (V) · 21 points · Final @($"{sweep[^1].Probe:G4} V")</figcaption>
                </figure>
            }
        }
    </section>
    }
    <BridgePanel Session="session" />
    @if (IsRc && transientResult is { } rc)
    {
        <section class="results" aria-label="RC transient results">
            <div><p class="eyebrow">NATIVE TRANSIENT</p><h2>RC charging waveform</h2>
                @if (rc.Transient is { } measured)
                {
                    <p>Probe @measured.ProbeId · R × C = @((measured.Input.TimeConstant * 1000).ToString("G4")) ms</p>
                    <p data-testid="rc-final">Final @measured.Samples[^1].Volts.ToString("F4") V</p>
                    @if (!session.IsCurrent(measured.Id, measured.Version))
                    {
                        <p role="status">The circuit changed. Run the transient again to update this trace.</p>
                    }
                }
                else
                {
                    <p role="status">@rc.Message</p>
                }
            </div>
            @if (rc.Transient is { } run)
            {
                <figure>
                    <svg viewBox="0 0 520 220" role="img" aria-label="RC probe voltage against time">
                        <path d="M60 25V174H493" class="axis" />
                        <path d="M60 99H493M276 25V174" class="guide" />
                        <polyline class="trace" points="@TransientPlot(run)" />
                        <foreignObject x="6" y="15" width="53" height="30"><span>@run.Input.Volts V</span></foreignObject>
                        <foreignObject x="12" y="153" width="46" height="20"><span>0 V</span></foreignObject>
                        <foreignObject x="192" y="185" width="175" height="25"><span>Time (ms)</span></foreignObject>
                        <foreignObject x="424" y="182" width="90" height="25"><span>@((run.Input.StopSeconds * 1000).ToString("G4")) ms</span></foreignObject>
                    </svg>
                    <figcaption><span class="legend"></span> @run.ProbeId voltage (V) · @run.Samples.Count samples</figcaption>
                </figure>
            }
        </section>
    }
</main>

@code {
    private readonly LessonSession session = new();
    private void OpenBridgeDemo() => Dispatch(new LoadBridgeDemo(session.Version));
    private string? selected => session.Selected;
    private Pin? pending => session.PendingPin;
    private Kind? placing => session.Placement;
    private CommandResult? preflight;
    private CommandResult? sweepResult;
    private CommandResult? transientResult;
    private bool transientRunning;
    private bool IsRc => session.Parts.Any(part => part.Kind == Kind.PulseVoltage);
    private double? ProbeVoltage => transientResult?.Transient is { } run && session.IsCurrent(run.Id, run.Version)
        ? run.Samples[^1].Volts : session.Probe;

    private async Task RunRc(string probeId)
    {
        transientRunning = true;
        try
        {
            transientResult = await session.ExecuteTransientAsync(new RunTransient(session.Version, probeId), RcSolver.SolveAsync);
            status = transientResult.Message;
            if (transientResult.Findings is not null) preflight = transientResult;
        }
        finally { transientRunning = false; }
    }

    private static string TransientPlot(TransientRun run) =>
        string.Join(" ", run.Samples.Select(sample =>
            $"{Coordinate(60 + 433 * (sample.Seconds / run.Input.StopSeconds))},{Coordinate(174 - 149 * (sample.Volts / run.Input.Volts))}"));

    private static string Plot(IReadOnlyList<SweepSample> sweep, double limit) =>
        string.Join(" ", sweep.Select(point =>
            $"{Coordinate(60 + 433 * (point.Input / limit))},{Coordinate(174 - 149 * (point.Probe / limit))}"));

    private static string Coordinate(double value) => value.ToString("0.###", CultureInfo.InvariantCulture);
    private const string Instructions = "Select a part to edit it. Select two terminals to draw a wire.";
    private string status = Instructions;

    // Explicit placement targets work equally with pointer and keyboard, regardless of SVG scaling.
    private static readonly (int X, int Y)[] Slots =
        (from y in new[] { 70, 160, 250, 310 } from x in new[] { 80, 200, 320, 440, 560 } select (x, y)).ToArray();

    private void Select(string id) => Dispatch(new SelectPart(id));
    private void Choose(Kind kind) => Dispatch(new ArmPlacement(kind));
    private void Place(Kind kind, (int X, int Y) slot) =>
        Dispatch(new PlacePart(session.Version, kind, slot.X, slot.Y));

    private void Apply()
    {
        if (session.Selected is string id)
        {
            var value = double.TryParse(session.DraftValue, CultureInfo.InvariantCulture, out var parsed)
                ? parsed : double.NaN;
            Dispatch(new SetPartValue(session.DraftVersion, id, value));
        }
    }

    private void Remove()
    {
        if (session.Selected is string id) Dispatch(new DeletePart(session.Version, id));
    }

    private void Reset() => Dispatch(new ResetLesson(session.Version));

    private void TapPin(Pin pin) => Dispatch(session.PendingPin is Pin first
        ? new ConnectPins(session.PendingVersion, first, pin)
        : new ArmPin(pin));

    private void Run() => sweepResult = Dispatch(new RunSweep(session.Version));

    private void CancelOnEscape(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && (placing is not null || pending is not null || session.MoveGesture is not null))
            Dispatch(new CancelGesture());
    }

    private CommandResult Dispatch(LessonCommand command, bool announce = true)
    {
        var result = session.Execute(command);
        if (result.Findings is not null) preflight = result;
        if (announce || result.Code != CommandCode.Ok) status = result.Message;
        return result;
    }

    private static string Input(ChangeEventArgs e) => e.Value?.ToString() ?? "";
    private static void Key(KeyboardEventArgs e, Action action)
    {
        if (e.Key is "Enter" or " ") action();
    }

    private void MoveTo(ArmMove move, (int X, int Y) slot) =>
        Dispatch(move.Duplicate
            ? new DuplicatePart(session.MoveVersion, move.PartId, slot.X, slot.Y)
            : new MovePart(session.MoveVersion, move.PartId, slot.X, slot.Y));

    private (int X, int Y) PinPosition(Pin pin) =>
        session.Parts.First(p => p.Id == pin.Part).PinPosition(pin.Index);

    private static string Orientation(Part part) =>
        $"rotate({part.QuarterTurns * 90}) scale({(part.Mirrored ? -1 : 1)} 1)";
    private static readonly Kind[] QuickParts = [Kind.Supply, Kind.Resistor, Kind.Ground, Kind.Probe];


    private IEnumerable<IGrouping<string, Kind>> VisibleParts() =>
        Enum.GetValues<Kind>().Where(kind =>
        {
            var spec = PartCatalog.Get(kind);
            return spec.Name.Contains(session.Filter, StringComparison.OrdinalIgnoreCase) ||
                   spec.Category.Contains(session.Filter, StringComparison.OrdinalIgnoreCase) ||
                   (kind is Kind.Nmos or Kind.Pmos && "mosfet".Contains(session.Filter, StringComparison.OrdinalIgnoreCase));
        }).GroupBy(kind => PartCatalog.Get(kind).Category);

    private static string PinLabel(Part part, int pin) =>
        $"{part.Id} terminal {pin + 1} · {PartCatalog.Get(part.Kind).Terminals[pin].Name}";

    private static string PartReadiness(Kind kind) => kind switch
    {
        Kind.PolarizedCapacitor => "Ideal capacitance in the forward RC lesson",
        Kind.PulseVoltage or Kind.Capacitor => "Native RC lesson supported",
        Kind.Resistor or Kind.Ground or Kind.Probe => "Divider and native RC lessons supported",
        Kind.Supply => "Divider and general solver supported",
        Kind.Current or Kind.Inductor or Kind.Vcvs or Kind.Vccs or Kind.Cccs or Kind.Ccvs => "General solver · linear device",
        Kind.Diode => "General solver · conduction and junction charge",
        Kind.Nmos or Kind.Pmos => "General solver · requires MOS1 or BSIM3 binding",
        Kind.Npn or Kind.Pnp => "General solver · requires a BJT conduction binding",
        Kind.CoupledInductor => "Drawing only · references to windings are pending",
        _ => "Placement and wiring only"
    };

    private const string StorageKey = "schematiclab.sheet.v1";

    private async Task SaveSheet()
    {
        var result = Dispatch(new SaveDocument());
        if (result.Document is null) return;
        try
        {
            await Browser.InvokeVoidAsync("localStorage.setItem", StorageKey, result.Document);
            status = "Sheet saved in this browser.";
        }
        catch (JSException) { status = "Browser storage is unavailable."; }
    }

    private async Task ReloadSheet()
    {
        var expected = session.Version;
        try
        {
            var document = await Browser.InvokeAsync<string?>("localStorage.getItem", StorageKey);
            if (document is null) status = "No saved sheet in this browser.";
            else if (Dispatch(new LoadDocument(expected, document)).Code == CommandCode.Ok) RestorePlots();
        }
        catch (JSException) { status = "Browser storage is unavailable."; }
    }

    private void RestoreEdit(DocumentCommand edit)
    {
        if (Dispatch(edit).Code == CommandCode.Ok) RestorePlots();
    }

    private void RestorePlots()
    {
        var history = session.History;
        var sweep = history.Sweeps.LastOrDefault();
        var transient = history.Transients.LastOrDefault();
        sweepResult = sweep is null ? null : session.Execute(new ReadRun(sweep.Id));
        transientResult = transient is null ? null : session.Execute(new ReadRun(transient.Id));
        preflight = null;
    }

    private void ChooseRun(ChangeEventArgs change)
    {
        if (!Guid.TryParse(Input(change), out var id)) return;
        var result = Dispatch(new ReadRun(id));
        if (result.Transient is not null) transientResult = result;
        if (result.Run is not null) sweepResult = result;
    }

    private void Draft(WiringDraft draft) => Dispatch(new UpdateWiringDraft(draft), announce: false);

    private static string TerminalKey(Pin? terminal) => terminal is { } pin ? $"{pin.Part}:{pin.Index}" : "";
    private static string WireKey(Wire? wire) => wire is { } value
        ? $"{TerminalKey(value.A)}|{TerminalKey(value.B)}" : "";
    private static string WireName(Wire wire) =>
        $"{wire.A.Part} pin {wire.A.Index + 1} to {wire.B.Part} pin {wire.B.Index + 1}";

    private void ChooseTerminal(ChangeEventArgs change)
    {
        var key = Input(change);
        Pin? selectedPin = null;
        foreach (var part in session.Parts)
            for (var i = 0; i < part.PinCount; i++)
                if (TerminalKey(new Pin(part.Id, i)) == key) selectedPin = new(part.Id, i);
        Draft(session.Wiring with
        {
            Terminal = selectedPin,
            Name = session.Labels.FirstOrDefault(label => label.Terminal == selectedPin)?.Name ?? ""
        });
    }

    private void ChooseWire(ChangeEventArgs change, bool second)
    {
        var key = Input(change);
        Wire? wire = session.Wires.Where(value => WireKey(value) == key).Select(value => (Wire?)value).FirstOrDefault();
        if (second) Draft(session.Wiring with { Second = wire });
        else
        {
            var route = session.Routes.FirstOrDefault(value => value.Wire == wire);
            Draft(session.Wiring with { First = wire, Bends = route is null ? "" :
                string.Join(" ", route.Bends.Select(point => $"{point.X},{point.Y}")) });
        }
    }

    private void ApplyLabel()
    {
        if (session.Wiring.Terminal is Pin pin)
            Dispatch(new SetNetLabel(session.Version, pin, session.Wiring.Name.Length == 0 ? null : session.Wiring.Name));
    }

    private void ApplyRoute()
    {
        if (session.Wiring.First is Wire wire && ReadPoints() is { } points)
            Dispatch(new SetWireRoute(session.Version, wire, points));
    }

    private void RemoveWire()
    {
        if (session.Wiring.First is Wire wire) Dispatch(new DeleteWire(session.Version, wire));
    }

    private void JoinAtPoint()
    {
        if (session.Wiring.First is not Wire first || session.Wiring.Second is not Wire second) return;
        if (ReadPoints() is [var point]) Dispatch(new JoinRoutes(session.Version, first, second, point));
        else status = "Enter one junction point shared by the two routes.";
    }

    private List<SheetPoint>? ReadPoints()
    {
        var points = new List<SheetPoint>();
        foreach (var token in session.Wiring.Bends.Split(' ', StringSplitOptions.RemoveEmptyEntries))
        {
            var pair = token.Split(',');
            if (pair.Length != 2 || !int.TryParse(pair[0], CultureInfo.InvariantCulture, out var x) ||
                !int.TryParse(pair[1], CultureInfo.InvariantCulture, out var y))
            {
                status = "Use x,y pairs separated by spaces.";
                return null;
            }
            points.Add(new(x, y));
        }
        return points;
    }

    private static string WirePoints((int X, int Y) a, (int X, int Y) b, IReadOnlyList<SheetPoint> bends) =>
        string.Join(" ", bends.Prepend(new(a.X, a.Y)).Append(new(b.X, b.Y)).Select(point => $"{point.X},{point.Y}"));

    private static string ValueLabel(Part part) => part.Kind switch
    {
        Kind.PulseVoltage => $"0–{part.Value:G4} V",
        Kind.Capacitor or Kind.PolarizedCapacitor => $"{part.Value * 1e6:G4} µF",
        Kind.Supply => $"{part.Value:0.##} V",
        Kind.Resistor => part.Value >= 1000 ? $"{part.Value / 1000:0.##} kΩ" : $"{part.Value:0.##} Ω",
        Kind.Probe => "V probe",
        _ => ""
    };
}
