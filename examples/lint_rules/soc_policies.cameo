// Example Tier 3 Cameo DSL custom lint rule pack for VeloSim.
// Statically type-checked against VeloSim's built-in LintContext prelude and
// executed inside a strictly hermetic, deterministic, step-budgeted Cameo VM.
//
// Usage:
//   VeloSim.Tools lint --check-rules --rules examples/lint_rules/soc_policies.cameo
//   VeloSim.Tools lint design.rtl.json --rules examples/lint_rules/soc_policies.cameo

rule({
    code = "SOC_POW2_MEM",
    phase = "rtl",
    group = "CAMEO",
    severity = "error",
    default_enabled = true,
    standards = ["CORP-MEM-001", "DO-254"],
    summary = "SRAM/register-file memory depths must be a power of two and within configured max_mem_depth.",
    hint = "Round the memory depth to a power of two or split into banked SRAM macros."
}, (ctx: LintContext) => {
    let maxDepth = ctx.param_int("max_mem_depth", 4096)
    for m in ctx.memories {
        if !rtl.is_pow2(m.depth) || m.depth > maxDepth {
            ctx.error(
                "SOC_POW2_MEM",
                $"Memory '{m.name}' depth {m.depth} (addr_bits={rtl.clog2(m.depth)}) must be a power of two <= {maxDepth}.",
                m.name,
                "memory"
            )
        }
    }
})

rule({
    code = "SOC_NO_WIDE_DIV",
    phase = "rtl",
    group = "CAMEO",
    severity = "warning",
    default_enabled = true,
    standards = ["CORP-AREA-004"],
    summary = "Disallow combinational division/modulo wider than max_div_width (default 16) for area closure.",
    hint = "Replace wide division with a multi-cycle divider or shift-and-add approximation."
}, (ctx: LintContext) => {
    let maxDivWidth = ctx.param_int("max_div_width", 16)
    for e in ctx.expressions {
        if (e.kind == "div" || e.kind == "mod") && e.width > maxDivWidth {
            ctx.warn(
                "SOC_NO_WIDE_DIV",
                $"Expression '{e.kind}' of width {e.width} exceeds {maxDivWidth}-bit SoC area budget.",
                nil,
                e.context
            )
        }
    }
})

rule({
    code = "SOC_FSM_MIN_WIDTH",
    phase = "fsm",
    group = "CAMEO",
    severity = "warning",
    default_enabled = true,
    standards = ["CORP-FSM-002", "DO-254"],
    summary = "Require every extracted FSM to define a constant reset state and default recovery.",
    hint = "Initialize the FSM state register on reset and add a default recovery state."
}, (ctx: LintContext) => {
    for f in ctx.fsms {
        if f.reset_state == "" || !f.has_default_recovery {
            ctx.warn(
                "SOC_FSM_MIN_WIDTH",
                $"FSM '{f.state_signal}' must define both a reset state and a default recovery clause.",
                f.state_signal,
                f.context
            )
        }
    }
})

rule({
    code = "SOC_CDC_NO_BUS",
    phase = "cdc",
    group = "CAMEO",
    severity = "error",
    default_enabled = true,
    standards = ["CORP-CDC-003", "ISO-26262"],
    summary = "Ban unsynchronized multi-bit (>1 bit) clock-domain crossings without a false-path.",
    hint = "Use a Gray-coded async FIFO or handshake synchronizer for multi-bit bus crossings."
}, (ctx: LintContext) => {
    for c in ctx.cdc_crossings {
        if c.kind == "CDC" && c.width > 1 && !c.synchronized && !c.false_path {
            ctx.error(
                "SOC_CDC_NO_BUS",
                $"Multi-bit ({c.width}-bit) bus crossing '{c.source_signal}' ({c.source_domain}) -> '{c.destination_signal}' ({c.destination_domain}) is forbidden.",
                c.destination_signal,
                c.context
            )
        }
    }
})
